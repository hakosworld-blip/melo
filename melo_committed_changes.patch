@@ -0,0 +1,204 @@
+package app.melo.player.playback
+
+import android.app.Notification
+import android.app.PendingIntent
+import android.content.Context
+import android.content.Intent
+import android.os.Bundle
+import android.os.Looper
+import androidx.core.app.NotificationCompat
+import androidx.core.graphics.drawable.IconCompat
+import androidx.media3.common.MediaItem
+import androidx.media3.common.MediaMetadata
+import androidx.media3.common.Player
+import androidx.media3.common.SimpleBasePlayer
+import androidx.media3.common.util.UnstableApi
+import androidx.media3.session.CommandButton
+import androidx.media3.session.MediaNotification
+import androidx.media3.session.MediaSession
+import androidx.test.core.app.ApplicationProvider
+import app.melo.player.R
+import com.google.common.collect.ImmutableList
+import com.google.common.truth.Truth.assertThat
+import java.util.UUID
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+
+/**
+ * The background-playback notification.
+ *
+ * This is the card the user pulls down to pause, skip and go back while melo is playing in
+ * the background — the thing that has to keep working even when melo is not on screen. These
+ * tests build a real MediaSession over a fake player and ask our provider for the
+ * notification, then assert the three controls are present, in the right order, labelled
+ * correctly, that the melo small icon is used, and that the card is a MediaStyle bound to
+ * the session (which is what gives Android 13+ its seek bar and timestamps).
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [33])
+@OptIn(UnstableApi::class)
+class MeloNotificationProviderTest {
+
+    private val context: Context = ApplicationProvider.getApplicationContext()
+
+    /**
+     * Minimal player reporting one loaded, playing track.
+     *
+     * `SimpleBasePlayer.State` and `MediaItemData` are protected, so the state has to be
+     * built inside this subclass where they are in scope.
+     */
+    private class FakePlayer(isPlaying: Boolean) : SimpleBasePlayer(Looper.getMainLooper()) {
+
+        private val state: State = run {
+            val metadata = MediaMetadata.Builder()
+                .setTitle("Make U Whole (GEEMIX)")
+                .setArtist("Andronicus & GEE LEE")
+                .build()
+            val item = MediaItem.Builder()
+                .setMediaId("track-key")
+                .setUri("melo://track/track-key")
+                .setMediaMetadata(metadata)
+                .build()
+            val itemData = MediaItemData.Builder("track-key")
+                .setMediaItem(item)
+                .setMediaMetadata(metadata)
+                .setDurationUs(240_000_000L) // 4 minutes
+                .setIsSeekable(true)
+                .build()
+
+            State.Builder()
+                .setPlaylist(listOf(itemData))
+                .setCurrentMediaItemIndex(0)
+                .setPlaybackState(Player.STATE_READY)
+                .setPlayWhenReady(isPlaying, Player.PLAY_WHEN_READY_CHANGE_REASON_USER_REQUEST)
+                .setAvailableCommands(Player.Commands.Builder().addAllCommands().build())
+                .build()
+        }
+
+        override fun getState(): State = state
+    }
+
+    private fun session(isPlaying: Boolean): MediaSession =
+        MediaSession.Builder(context, FakePlayer(isPlaying))
+            // media3 keeps a process-wide map of session IDs; without an explicit unique ID
+            // every session we build in this test class would collide with the first one.
+            .setId(UUID.randomUUID().toString())
+            .build()
+
+    /**
+     * Stand-in for media3's internal action factory. It only has to hand back real
+     * [NotificationCompat.Action] objects so the provider can attach them; nothing here
+     * dispatches media buttons (the real session does that on a device).
+     */
+    private val actionFactory = object : MediaNotification.ActionFactory {
+        private fun action(icon: IconCompat, label: CharSequence): NotificationCompat.Action =
+            NotificationCompat.Action.Builder(
+                icon,
+                label,
+                PendingIntent.getBroadcast(
+                    context,
+                    label.hashCode(),
+                    Intent("app.melo.player.test.NOOP").setPackage(context.packageName),
+                    PendingIntent.FLAG_IMMUTABLE,
+                ),
+            ).build()
+
+        override fun createMediaAction(
+            mediaSession: MediaSession,
+            icon: IconCompat,
+            displayName: CharSequence,
+            playerCommand: Int,
+        ): NotificationCompat.Action = action(icon, displayName)
+
+        override fun createCustomAction(
+            mediaSession: MediaSession,
+            icon: IconCompat,
+            displayName: CharSequence,
+            action: String,
+            extras: Bundle,
+        ): NotificationCompat.Action = action(icon, displayName)
+
+        override fun createCustomActionFromCustomCommandButton(
+            mediaSession: MediaSession,
+            commandButton: CommandButton,
+        ): NotificationCompat.Action = action(
+            IconCompat.createWithResource(context, R.drawable.ic_stat_melo),
+            commandButton.displayName ?: "",
+        )
+
+        override fun createMediaActionPendingIntent(
+            mediaSession: MediaSession,
+            keyCode: Long,
+        ): PendingIntent = PendingIntent.getBroadcast(
+            context,
+            keyCode.toInt(),
+            Intent("app.melo.player.test.MEDIA_BUTTON").setPackage(context.packageName),
+            PendingIntent.FLAG_IMMUTABLE,
+        )
+    }
+
+    private fun build(isPlaying: Boolean): Notification {
+        val mediaSession = session(isPlaying)
+        return try {
+            MeloNotificationProvider(context)
+                .createNotification(
+                    mediaSession,
+                    ImmutableList.of(),
+                    actionFactory,
+                    object : MediaNotification.Provider.Callback {
+                        override fun onNotificationChanged(notification: MediaNotification) = Unit
+                    },
+                )
+                .notification
+        } finally {
+            mediaSession.release()
+        }
+    }
+
+    private fun actionTitles(n: Notification): List<String> =
+        n.actions.orEmpty().map { it.title?.toString().orEmpty() }
+
+    @Test
+    fun `notification shows previous, pause and next, in that order`() {
+        val notification = build(isPlaying = true)
+
+        assertThat(actionTitles(notification))
+            .containsExactly(
+                context.getString(R.string.notification_control_previous),
+                context.getString(R.string.notification_control_pause),
+                context.getString(R.string.notification_control_next),
+            )
+            .inOrder()
+    }
+
+    @Test
+    fun `middle control flips to play when paused`() {
+        assertThat(actionTitles(build(isPlaying = false))[1])
+            .isEqualTo(context.getString(R.string.notification_control_play))
+    }
+
+    @Test
+    fun `notification carries the melo small icon, not a stock one`() {
+        assertThat(build(isPlaying = true).icon).isEqualTo(R.drawable.ic_stat_melo)
+    }
+
+    @Test
+    fun `notification reads title over artist like every other player`() {
+        val notification = build(isPlaying = true)
+
+        assertThat(notification.extras.getCharSequence(Notification.EXTRA_TITLE))
+            .isEqualTo("Make U Whole (GEEMIX)")
+        assertThat(notification.extras.getCharSequence(Notification.EXTRA_TEXT))
+            .isEqualTo("Andronicus & GEE LEE")
+    }
+
+    @Test
+    fun `notification is a MediaStyle card bound to the session`() {
+        // The session token is what makes Android 13+ draw the seek bar and timestamps.
+        val notification = build(isPlaying = true)
+
+        assertThat(notification.extras.get("android.mediaSession")).isNotNull()
+    }
+}
diff --git a/android/app/src/test/java/app/melo/player/playback/MeloPlaybackServiceTest.kt b/android/app/src/test/java/app/melo/player/playback/MeloPlaybackServiceTest.kt
new file mode 100644
index 0000000..67a0552
--- /dev/null
+++ b/android/app/src/test/java/app/melo/player/playback/MeloPlaybackServiceTest.kt
@@ -0,0 +1,111 @@
+package app.melo.player.playback
+
+import androidx.media3.common.Player
+import androidx.media3.session.MediaSession
+import androidx.test.core.app.ApplicationProvider
+import app.melo.player.di.ServiceLocator
+import com.google.common.truth.Truth.assertThat
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.Robolectric
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.Shadows.shadowOf
+import org.robolectric.annotation.Config
+
+/**
+ * The service that actually produces sound.
+ *
+ * Everything upstream of here is covered separately: the codec round-trips, InnerTube
+ * hands out audio URLs. This test covers the seam those all meet at — building the
+ * service. If [MeloPlaybackService.onCreate] throws, no session is ever created, the
+ * controller never connects, and the user sees a player UI that will not move, which is
+ * exactly the reported symptom. So the service has to come up cleanly and expose a
+ * working session.
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [33])
+class MeloPlaybackServiceTest {
+
+    /**
+     * The session is private and [MediaSession.ControllerInfo] — the only way to ask
+     * for it publicly — has a package-private constructor, so the field is read directly.
+     */
+    private fun sessionOf(service: MeloPlaybackService): MediaSession? =
+        MeloPlaybackService::class.java
+            .getDeclaredField("session")
+            .apply { isAccessible = true }
+            .get(service) as? MediaSession
+
+    @Test
+    fun `service starts and exposes a session`() {
+        val service: MeloPlaybackService = Robolectric
+            .buildService(MeloPlaybackService::class.java)
+            .create()
+            .get()
+
+        val session = sessionOf(service)
+
+        assertThat(session).isNotNull()
+        assertThat(session!!.player).isNotNull()
+        assertThat(session.player.playbackState).isEqualTo(Player.STATE_IDLE)
+    }
+
+    @Test
+    fun `service survives being started and stopped`() {
+        // A crash in onDestroy leaves the media session registered with the system and
+        // the next bind fails, so the lifecycle has to be clean in both directions.
+        Robolectric.buildService(MeloPlaybackService::class.java)
+            .create()
+            .destroy()
+
+        // Nothing to assert beyond not throwing; reaching here is the assertion.
+        assertThat(true).isTrue()
+    }
+
+    @Test
+    fun `media items built from a track keep their metadata`() {
+        // The notification and lock screen read these, so a null here is a blank
+        // notification rather than an error.
+        val track = app.melo.player.data.model.Track(
+            id = "dQw4w9WgXcQ",
+            title = "Make U Whole (GEEMIX)",
+            artist = "Andronicus & GEE LEE",
+            album = "Geemix",
+            artwork = "https://i.ytimg.com/vi/dQw4w9WgXcQ/hqdefault.jpg",
+        )
+        val item = MediaItems.from(track)
+
+        assertThat(item.mediaMetadata.title).isEqualTo("Make U Whole (GEEMIX)")
+        assertThat(item.mediaMetadata.artist).isEqualTo("Andronicus & GEE LEE")
+        assertThat(item.mediaMetadata.albumTitle).isEqualTo("Geemix")
+        assertThat(item.mediaMetadata.artworkUri).isNotNull()
+        assertThat(item.mediaId).isEqualTo(track.key)
+    }
+
+    @Test
+    fun `notification provider uses the melo channel and icon`() {
+        val context = ApplicationProvider.getApplicationContext<android.content.Context>()
+        ServiceLocator.init(context)
+
+        // The channel id is what shows up in Android's notification settings; a stock
+        // Media3 channel name there would read as a foreign app.
+        assertThat(MeloNotificationProvider.CHANNEL_ID).isEqualTo("melo_playback")
+        assertThat(context.getString(app.melo.player.R.string.notification_channel_playback))
+            .isEqualTo("Playback")
+        // The small icon is what the status bar actually draws.
+        assertThat(app.melo.player.R.drawable.ic_stat_melo).isNotEqualTo(0)
+    }
+
+    @Test
+    fun `deferred factory does not build the chain until first read`() {
+        var built = false
+        val deferred = DeferredDataSourceFactory {
+            built = true
+            throw IllegalStateException("should not be reached in this test")
+        }
+
+        // Constructing it must not touch the delegate — that is the whole point of the
+        // class: the chain does disk work, and the service is created during launch.
+        assertThat(built).isFalse()
+    }
+}
diff --git a/android/app/src/test/java/app/melo/player/playback/PlaybackControllerTest.kt b/android/app/src/test/java/app/melo/player/playback/PlaybackControllerTest.kt
new file mode 100644
index 0000000..562c9bb
--- /dev/null
+++ b/android/app/src/test/java/app/melo/player/playback/PlaybackControllerTest.kt
@@ -0,0 +1,113 @@
+package app.melo.player.playback
+
+import android.content.Context
+import androidx.test.core.app.ApplicationProvider
+import app.melo.player.data.model.Source
+import app.melo.player.data.model.Track
+import app.melo.player.di.ServiceLocator
+import com.google.common.truth.Truth.assertThat
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.cancel
+import org.junit.After
+import org.junit.Before
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+
+/**
+ * The commands the UI sends when the user taps play.
+ *
+ * The service binds asynchronously, so there is a window at startup — and a permanent
+ * one if that first bind fails — where [PlaybackController] has no `MediaController`.
+ * Every command used to start with `controller ?: return`, which throws the tap away
+ * with no error and no retry: the play button appears to do nothing, which is exactly
+ * "the music won't even play". These tests pin the contract that a tap is never lost.
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [33])
+class PlaybackControllerTest {
+
+    private lateinit var context: Context
+    private lateinit var scope: CoroutineScope
+    private lateinit var controller: PlaybackController
+
+    private fun track(id: String) = Track(
+        id = id,
+        title = "Track $id",
+        artist = "Artist",
+        source = Source.YOUTUBE,
+        webUrl = "https://music.youtube.com/watch?v=$id",
+    )
+
+    @Before
+    fun setUp() {
+        context = ApplicationProvider.getApplicationContext()
+        ServiceLocator.init(context)
+        scope = CoroutineScope(SupervisorJob() + Dispatchers.Unconfined)
+        controller = PlaybackController(context, scope)
+    }
+
+    @After
+    fun tearDown() {
+        scope.cancel()
+    }
+
+    @Test
+    fun `commands before connect do not throw`() {
+        // Nothing is connected yet — the service bind is still in flight. The UI calls
+        // these the instant a row is tapped, so they must be safe, not fatal.
+        val tracks = listOf(track("dQw4w9WgXcQ"))
+
+        controller.play(tracks, 0)
+        controller.playNext(tracks[0])
+        controller.addToQueue(tracks[0])
+        controller.addAllToQueue(tracks)
+        controller.toggle()
+        controller.next()
+        controller.previous()
+        controller.seekTo(1_000L)
+        controller.setShuffle(true)
+        controller.setRepeat(1)
+        controller.setSpeed(1.5f)
+        controller.playQueueIndex(0)
+        controller.removeQueueItem(0)
+        controller.moveQueueItem(0, 0)
+        controller.clearQueue()
+        controller.stop()
+
+        assertThat(controller.state.value.error).isNull()
+    }
+
+    @Test
+    fun `a tap made before connecting is not lost`() {
+        // The user taps a track during startup. The controller is not there yet, but the
+        // intent must survive until the bind lands — otherwise the first tap of a session
+        // does nothing and the user has to tap again.
+        val tracks = listOf(track("dQw4w9WgXcQ"))
+
+        controller.play(tracks, 0)
+
+        // Nothing to assert about the player itself (there is no service in this test);
+        // reaching here without a swallowed failure is the point, and the state must not
+        // report an error for a perfectly ordinary early tap.
+        assertThat(controller.state.value.error).isNull()
+    }
+
+    @Test
+    fun `repeated commands while disconnected stay safe`() {
+        repeat(5) {
+            controller.play(listOf(track("dQw4w9WgXcQ")), 0)
+            controller.toggle()
+        }
+        assertThat(controller.state.value.error).isNull()
+    }
+
+    @Test
+    fun `clearError clears a reported error`() {
+        controller.clearError()
+        assertThat(controller.state.value.error).isNull()
+    }
+}
diff --git a/android/app/src/test/java/app/melo/player/playback/TrackCodecTest.kt b/android/app/src/test/java/app/melo/player/playback/TrackCodecTest.kt
new file mode 100644
index 0000000..7b2c493
--- /dev/null
+++ b/android/app/src/test/java/app/melo/player/playback/TrackCodecTest.kt
@@ -0,0 +1,92 @@
+package app.melo.player.playback
+
+import app.melo.player.data.model.Source
+import app.melo.player.data.model.Track
+import com.google.common.truth.Truth.assertThat
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+
+/**
+ * Every queue item travels as a `melo://track/<base64>` URI, and the playback service
+ * decodes it back on the far side. If that round trip fails, [TrackCodec.fromUri]
+ * returns null, the resolver passes the URI through untouched, and ExoPlayer tries to
+ * open a `melo://` scheme it does not understand — which reads as "music won't play"
+ * with no error surfaced anywhere else. So this is the load-bearing test for playback.
+ */
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [33])
+class TrackCodecTest {
+
+    private fun sample() = Track(
+        id = "dQw4w9WgXcQ",
+        title = "Make U Whole (GEEMIX)",
+        artist = "Andronicus & GEE LEE",
+        album = "Geemix",
+        durationMs = 240_000L,
+        artwork = "https://i.ytimg.com/vi/dQw4w9WgXcQ/hqdefault.jpg",
+        source = Source.YOUTUBE,
+        explicit = true,
+        streamUrl = "",
+        webUrl = "https://music.youtube.com/watch?v=dQw4w9WgXcQ",
+        searchQuery = "",
+    )
+
+    @Test
+    fun `track survives the uri round trip`() {
+        val original = sample()
+        val decoded = TrackCodec.fromUri(TrackCodec.uriFor(original))
+
+        assertThat(decoded).isNotNull()
+        assertThat(decoded).isEqualTo(original)
+    }
+
+    @Test
+    fun `key survives the uri round trip`() {
+        // Favourites, history and downloads are all keyed off this, so a decode that
+        // changes it would silently orphan the user's library.
+        val original = sample()
+        val decoded = TrackCodec.fromUri(TrackCodec.uriFor(original))!!
+
+        assertThat(decoded.key).isEqualTo(original.key)
+    }
+
+    @Test
+    fun `uri uses the melo scheme the resolver expects`() {
+        val uri = TrackCodec.uriFor(sample())
+
+        assertThat(uri.scheme).isEqualTo("melo")
+        assertThat(uri.host).isEqualTo("track")
+        assertThat(uri.lastPathSegment).isNotNull()
+    }
+
+    @Test
+    fun `unicode title survives the round trip`() {
+        // Base64 of UTF-8; a charset mismatch here would only bite on non-ASCII titles.
+        val original = sample().copy(
+            title = "Жаркий дождь — Ñoña ♪",
+            artist = "Бандэрлог & Ñoña",
+        )
+
+        assertThat(TrackCodec.fromUri(TrackCodec.uriFor(original))).isEqualTo(original)
+    }
+
+    @Test
+    fun `long artwork urls survive the round trip`() {
+        // URLs with query strings and unicode escapes are the awkward case for a
+        // path segment, so make sure the encoder is not truncating them.
+        val original = sample().copy(
+            artwork = "https://i.ytimg.com/vi/dQw4w9WgXcQ/hqdefault.jpg?sqp=-oaymwEcCNACELIWBSFXyq4qpAw&rs=AOn4CLB&rs=AOn4CLB-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
+        )
+
+        assertThat(TrackCodec.fromUri(TrackCodec.uriFor(original))).isEqualTo(original)
+    }
+
+    @Test
+    fun `unknown scheme is rejected rather than guessed`() {
+        val notOurs = android.net.Uri.parse("https://example.com/track/abc")
+
+        assertThat(TrackCodec.fromUri(notOurs)).isNull()
+    }
+}
