--- /dev/null
+++ b/android/app/src/test/java/app/melo/player/data/local/MeloNamesTest.kt
@@ -0,0 +1,78 @@
+package app.melo.player.data.local
+
+import app.melo.player.data.model.Source
+import app.melo.player.data.model.Track
+import com.google.common.truth.Truth.assertThat
+import org.junit.Test
+
+class MeloNamesTest {
+
+    private fun track(title: String, artist: String) = Track(
+        id = "abc123",
+        title = title,
+        artist = artist,
+        source = Source.YOUTUBE,
+    )
+
+    @Test
+    fun `file base keeps the artist and the song`() {
+        assertThat(MeloNames.fileBase(track("Get Lucky", "Daft Punk")))
+            .isEqualTo("Daft Punk - Get Lucky")
+    }
+
+    @Test
+    fun `file base strips what a filesystem refuses`() {
+        val base = MeloNames.fileBase(track("AC/DC: Back? <live>", "AC/DC"))
+        listOf('/', ':', '?', '<', '>', '\\', '"', '*', '|').forEach { character ->
+            assertThat(base).doesNotContain(character.toString())
+        }
+        assertThat(base).contains("AC_DC")
+    }
+
+    @Test
+    fun `file base never comes back empty`() {
+        assertThat(MeloNames.fileBase(track("", ""))).isEqualTo("Unknown artist - Untitled")
+        assertThat(MeloNames.fileBase(track("   ", "  "))).isEqualTo("Unknown artist - Untitled")
+    }
+
+    @Test
+    fun `extension follows the container the stream really is`() {
+        assertThat(MeloNames.extensionFor("https://x/y?mime=audio%2Fmp4&expire=1")).isEqualTo("m4a")
+        assertThat(MeloNames.extensionFor("https://x/y?mime=audio%2Fwebm")).isEqualTo("webm")
+        assertThat(MeloNames.extensionFor("https://x/y/track.mp3?token=1")).isEqualTo("mp3")
+    }
+
+    @Test
+    fun `mime and audio detection line up with the extension`() {
+        assertThat(MeloNames.mimeFor("m4a")).isEqualTo("audio/mp4")
+        assertThat(MeloNames.mimeFor("mp3")).isEqualTo("audio/mpeg")
+        assertThat(MeloNames.mimeFor("webm")).isEqualTo("audio/webm")
+
+        assertThat(MeloNames.isAudio("Daft Punk - Get Lucky.m4a")).isTrue()
+        assertThat(MeloNames.isAudio("Daft Punk - Get Lucky.MP3")).isTrue()
+        assertThat(MeloNames.isAudio("Daft Punk - Get Lucky.lrc")).isFalse()
+        assertThat(MeloNames.isAudio("Daft Punk - Get Lucky.json")).isFalse()
+        assertThat(MeloNames.isAudio("Daft Punk - Get Lucky.jpg")).isFalse()
+    }
+
+    @Test
+    fun `base name drops only the last extension`() {
+        assertThat(MeloNames.baseName("A - B (2).m4a")).isEqualTo("A - B (2)")
+        assertThat(MeloNames.baseName("no extension here")).isEqualTo("no extension here")
+    }
+
+    @Test
+    fun `the local id is stable and usable as a track id`() {
+        val first = MeloNames.localId("Daft Punk - Get Lucky.m4a")
+        assertThat(first).isEqualTo(MeloNames.localId("Daft Punk - Get Lucky.m4a"))
+        assertThat(first).isNotEqualTo(MeloNames.localId("Daft Punk - Around the World.m4a"))
+        assertThat(first).doesNotContain(" ")
+        assertThat(first).doesNotContain("/")
+    }
+
+    @Test
+    fun `a file name is split back into artist and song`() {
+        assertThat(MeloNames.titleFromFile("Daft Punk - Get Lucky.m4a")).isEqualTo("Get Lucky")
+        assertThat(MeloNames.titleFromFile("Mystery Track.m4a")).isEqualTo("Mystery Track")
+    }
+}
diff --git a/android/app/src/test/java/app/melo/player/data/local/MeloSidecarTest.kt b/android/app/src/test/java/app/melo/player/data/local/MeloSidecarTest.kt
new file mode 100644
index 0000000..4f7075e
--- /dev/null
+++ b/android/app/src/test/java/app/melo/player/data/local/MeloSidecarTest.kt
@@ -0,0 +1,88 @@
+package app.melo.player.data.local
+
+import app.melo.player.data.model.Source
+import app.melo.player.data.model.Track
+import com.google.common.truth.Truth.assertThat
+import org.junit.Test
+
+/**
+ * The rules that match a playing track back to the files melo saved beside it. Getting
+ * these wrong means a downloaded song silently falls back to the network for its lyrics.
+ */
+class MeloSidecarTest {
+
+    private fun file(name: String, ref: String = "content://media/external/file/1") =
+        MeloFolder.FolderFile(
+            name = name,
+            ref = ref,
+            mime = "audio/mp4",
+            size = 1_024L,
+            modified = 0L,
+        )
+
+    private val track = Track(
+        id = "abc123",
+        title = "Get Lucky",
+        artist = "Daft Punk",
+        source = Source.YOUTUBE,
+    )
+
+    @Test
+    fun `the library row names the files`() {
+        val base = MeloSidecar.baseNameFor(
+            track,
+            rowPath = "Daft Punk - Get Lucky.m4a",
+            audioFiles = emptyList(),
+        )
+        assertThat(base).isEqualTo("Daft Punk - Get Lucky")
+    }
+
+    @Test
+    fun `a track played straight out of the folder is matched by its file reference`() {
+        val ref = "content://media/external/file/99"
+        val base = MeloSidecar.baseNameFor(
+            track.copy(source = Source.LOCAL, streamUrl = ref),
+            rowPath = null,
+            audioFiles = listOf(file("Daft Punk - Something Else.m4a", "content://x"), file("Daft Punk - Get Lucky.m4a", ref)),
+        )
+        assertThat(base).isEqualTo("Daft Punk - Get Lucky")
+    }
+
+    @Test
+    fun `a song with no row falls back to the name melo would have given it`() {
+        val base = MeloSidecar.baseNameFor(
+            track,
+            rowPath = "",
+            audioFiles = listOf(file("Daft Punk - Get Lucky.m4a")),
+        )
+        assertThat(base).isEqualTo("Daft Punk - Get Lucky")
+    }
+
+    @Test
+    fun `a remote stream url is never mistaken for a folder file`() {
+        val base = MeloSidecar.baseNameFor(
+            track.copy(streamUrl = "https://example.com/get-lucky.m4a"),
+            rowPath = null,
+            audioFiles = listOf(file("Daft Punk - Get Lucky.m4a")),
+        )
+        // Matched by name, not by the URL.
+        assertThat(base).isEqualTo("Daft Punk - Get Lucky")
+    }
+
+    @Test
+    fun `a song that is not in the folder has no files`() {
+        val base = MeloSidecar.baseNameFor(
+            track.copy(id = "other", title = "A song melo never saved"),
+            rowPath = null,
+            audioFiles = listOf(file("Daft Punk - Get Lucky.m4a")),
+        )
+        assertThat(base).isNull()
+    }
+
+    @Test
+    fun `sidecar names share the song's base name`() {
+        assertThat(MeloSidecar.lyricsName("Daft Punk - Get Lucky")).isEqualTo("Daft Punk - Get Lucky.lrc")
+        assertThat(MeloSidecar.artworkName("Daft Punk - Get Lucky")).isEqualTo("Daft Punk - Get Lucky.jpg")
+        assertThat(MeloSidecar.metaName("Daft Punk - Get Lucky")).isEqualTo("Daft Punk - Get Lucky.json")
+    }
+}
diff --git a/android/app/src/test/java/app/melo/player/data/lyrics/LyricsWriterTest.kt b/android/app/src/test/java/app/melo/player/data/lyrics/LyricsWriterTest.kt
