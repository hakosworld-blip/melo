<?xml version="1.0" encoding="utf-8"?>
<!--
  melo's logo, used by the base launcher icon (app info, splash). Same artwork as
  ic_mark_01 so the icon on the home screen and the one in system settings match:
  a light grey disc on solid black with a bold serif lowercase "m" laid over it. The
  letter is wider than the disc, so its right side crosses the disc's right boundary
  and runs out onto the black — the disc reads as cut through by the "m".
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The disc: centred on 54,54 with radius 31. -->
    <path
        android:fillColor="#DCDCDC"
        android:pathData="M23,54 A31,31 0 1,0 85,54 A31,31 0 1,0 23,54 Z" />

    <!-- The letter: a square-topped stem with two arch humps dipping between them, and long
         thin slit counters that leave only hairline joins at the stems (even-odd holes). -->
    <path
        android:fillColor="#000000"
        android:fillType="evenOdd"
        android:pathData="M42.5,67 V43.5 C46,39 57,38 65,51.5 C73,38 84,39 87,44.5 V67 Z M52.4,53 H65.6 A1.2,1.2 0 0 1 65.6,55.4 H52.4 A1.2,1.2 0 0 1 52.4,53 Z M70.6,53 H83.6 A1.2,1.2 0 0 1 83.6,55.4 H70.6 A1.2,1.2 0 0 1 70.6,53 Z" />

    <!-- Serif feet at the baseline. -->
    <path
        android:fillColor="#000000"
        android:pathData="M41.5,64.5 H48 V67 H41.5 Z" />
    <path
        android:fillColor="#000000"
        android:pathData="M60,64.5 H70 V67 H60 Z" />
    <path
        android:fillColor="#000000"
        android:pathData="M84,64.5 H89 V67 H84 Z" />
</vector>
